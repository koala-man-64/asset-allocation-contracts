{
  "$defs": {
    "OptionContractIdentity": {
      "additionalProperties": false,
      "properties": {
        "exerciseStyle": {
          "default": "american",
          "enum": [
            "american",
            "european"
          ],
          "title": "Exercisestyle",
          "type": "string"
        },
        "expirationDate": {
          "format": "date",
          "title": "Expirationdate",
          "type": "string"
        },
        "multiplier": {
          "default": 100,
          "exclusiveMinimum": 0,
          "title": "Multiplier",
          "type": "integer"
        },
        "optionSymbol": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Optionsymbol",
          "type": "string"
        },
        "right": {
          "enum": [
            "call",
            "put"
          ],
          "title": "Right",
          "type": "string"
        },
        "rootSymbol": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rootsymbol"
        },
        "settlementStyle": {
          "default": "physical",
          "enum": [
            "physical",
            "cash"
          ],
          "title": "Settlementstyle",
          "type": "string"
        },
        "strikePrice": {
          "exclusiveMinimum": 0,
          "title": "Strikeprice",
          "type": "number"
        },
        "underlyingSymbol": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Underlyingsymbol",
          "type": "string"
        }
      },
      "required": [
        "underlyingSymbol",
        "optionSymbol",
        "expirationDate",
        "strikePrice",
        "right"
      ],
      "title": "OptionContractIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "$ref": "#/$defs/OptionContractIdentity"
    },
    "legId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Legid",
      "type": "string"
    },
    "limitPrice": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limitprice"
    },
    "openClose": {
      "default": "open",
      "enum": [
        "open",
        "close"
      ],
      "title": "Openclose",
      "type": "string"
    },
    "premium": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Premium"
    },
    "quantity": {
      "default": 1,
      "minimum": 1,
      "title": "Quantity",
      "type": "integer"
    },
    "ratio": {
      "default": 1,
      "minimum": 1,
      "title": "Ratio",
      "type": "integer"
    },
    "role": {
      "enum": [
        "stock",
        "long_call",
        "short_call",
        "long_put",
        "short_put",
        "long_wing",
        "short_body",
        "underlying_stock",
        "cash_reserve"
      ],
      "title": "Role",
      "type": "string"
    },
    "side": {
      "enum": [
        "long",
        "short"
      ],
      "title": "Side",
      "type": "string"
    }
  },
  "required": [
    "legId",
    "contract",
    "side",
    "role"
  ],
  "title": "OptionLeg",
  "type": "object"
}
