      "type": "string"
    },
    "providers": {
      "items": {
        "enum": [
          "alpha_vantage",
          "quiver",
          "openai_responses",
          "alpaca",
          "etrade",
          "schwab",
          "kalshi"
        ],
        "type": "string"
      },
      "title": "Providers",
      "type": "array"
    },
    "ruleCount": {
      "default": 0,
      "minimum": 0,
