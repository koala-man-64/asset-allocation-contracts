{
  "$defs": {
    "OptionContractIdentity": {
      "additionalProperties": false,
      "properties": {
        "exerciseStyle": {
          "default": "american",
          "enum": [
            "american",
            "european"
          ],
          "title": "Exercisestyle",
          "type": "string"
        },
        "expirationDate": {
          "format": "date",
          "title": "Expirationdate",
          "type": "string"
        },
        "multiplier": {
          "default": 100,
          "exclusiveMinimum": 0,
          "title": "Multiplier",
          "type": "integer"
        },
        "optionSymbol": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Optionsymbol",
          "type": "string"
        },
        "right": {
          "enum": [
            "call",
            "put"
          ],
          "title": "Right",
          "type": "string"
        },
        "rootSymbol": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rootsymbol"
        },
        "settlementStyle": {
          "default": "physical",
          "enum": [
            "physical",
            "cash"
          ],
          "title": "Settlementstyle",
          "type": "string"
        },
        "strikePrice": {
          "exclusiveMinimum": 0,
          "title": "Strikeprice",
          "type": "number"
        },
        "underlyingSymbol": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Underlyingsymbol",
          "type": "string"
        }
      },
      "required": [
        "underlyingSymbol",
        "optionSymbol",
        "expirationDate",
        "strikePrice",
        "right"
      ],
      "title": "OptionContractIdentity",
      "type": "object"
    },
    "OptionLeg": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "$ref": "#/$defs/OptionContractIdentity"
        },
        "legId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Legid",
          "type": "string"
        },
        "limitPrice": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limitprice"
        },
        "openClose": {
          "default": "open",
          "enum": [
            "open",
            "close"
          ],
          "title": "Openclose",
          "type": "string"
        },
        "premium": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Premium"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "ratio": {
          "default": 1,
          "minimum": 1,
          "title": "Ratio",
          "type": "integer"
        },
        "role": {
          "enum": [
            "stock",
            "long_call",
            "short_call",
            "long_put",
            "short_put",
            "long_wing",
            "short_body",
            "underlying_stock",
            "cash_reserve"
          ],
          "title": "Role",
          "type": "string"
        },
        "side": {
          "enum": [
            "long",
            "short"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "legId",
        "contract",
        "side",
        "role"
      ],
      "title": "OptionLeg",
      "type": "object"
    },
    "StrategyReferenceInput": {
      "additionalProperties": false,
      "properties": {
        "strategyName": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Strategyname",
          "type": "string"
        },
        "strategyVersion": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strategyversion"
        }
      },
      "required": [
        "strategyName"
      ],
      "title": "StrategyReferenceInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accountId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Accountid",
      "type": "string"
    },
    "allowExtendedHours": {
      "default": false,
      "title": "Allowextendedhours",
      "type": "boolean"
    },
    "assetClass": {
      "default": "equity",
      "enum": [
        "equity",
        "etf",
        "option",
        "crypto",
        "mutual_fund",
        "prediction_market",
        "unknown"
      ],
      "title": "Assetclass",
      "type": "string"
    },
    "clientRequestId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Clientrequestid",
      "type": "string"
    },
    "confirmationToken": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmationtoken"
    },
    "confirmedAt": {
      "format": "date-time",
      "title": "Confirmedat",
      "type": "string"
    },
    "confirmedRiskCheckIds": {
      "items": {
        "type": "string"
      },
      "title": "Confirmedriskcheckids",
      "type": "array"
    },
    "environment": {
      "enum": [
        "paper",
        "sandbox",
        "live"
      ],
      "title": "Environment",
      "type": "string"
    },
    "idempotencyKey": {
      "maxLength": 160,
      "minLength": 16,
      "title": "Idempotencykey",
      "type": "string"
    },
    "instrumentName": {
      "anyOf": [
        {
          "maxLength": 240,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instrumentname"
    },
    "limitPrice": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limitprice"
    },
    "notional": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notional"
    },
    "optionLegs": {
      "items": {
        "$ref": "#/$defs/OptionLeg"
      },
      "title": "Optionlegs",
      "type": "array"
    },
    "optionStrategyId": {
      "anyOf": [
        {
          "enum": [
            "covered_call",
            "cash_secured_put",
            "long_call",
            "long_put",
            "protective_put",
            "collar",
            "bull_call_spread",
            "bear_put_spread",
            "bull_put_spread",
            "bear_call_spread",
            "long_straddle",
            "long_strangle",
            "iron_condor",
            "iron_butterfly",
            "long_butterfly",
            "calendar_spread",
            "diagonal_spread",
            "pmcc",
            "covered_straddle",
            "covered_combination",
            "covered_strangle"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Optionstrategyid"
    },
    "orderHash": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Orderhash"
    },
    "orderType": {
      "enum": [
        "market",
        "limit",
        "stop",
        "stop_limit"
      ],
      "title": "Ordertype",
      "type": "string"
    },
    "outcomeSide": {
      "anyOf": [
        {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcomeside"
    },
    "policyVersion": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policyversion"
    },
    "previewId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Previewid",
      "type": "string"
    },
    "providerInstrumentId": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Providerinstrumentid"
    },
    "quantity": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quantity"
    },
    "side": {
      "enum": [
        "buy",
        "sell"
      ],
      "title": "Side",
      "type": "string"
    },
    "source": {
      "default": "manual",
      "enum": [
        "manual",
        "rebalance_preview",
        "system"
      ],
      "title": "Source",
      "type": "string"
    },
    "stopPrice": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stopprice"
    },
    "strategyRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/StrategyReferenceInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "symbol": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Symbol",
      "type": "string"
    },
    "timeInForce": {
      "default": "day",
      "enum": [
        "day",
        "gtc",
        "opg",
        "cls",
        "ioc",
        "fok"
      ],
      "title": "Timeinforce",
      "type": "string"
    }
  },
  "required": [
    "accountId",
    "environment",
    "clientRequestId",
    "symbol",
    "side",
    "orderType",
    "idempotencyKey",
    "previewId",
    "confirmedAt"
  ],
  "title": "TradeOrderPlaceRequest",
  "type": "object"
}
