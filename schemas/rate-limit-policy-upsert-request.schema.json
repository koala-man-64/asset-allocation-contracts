{
  "$defs": {
    "RateLimitPolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "rules": {
          "items": {
            "$ref": "#/$defs/RateLimitRule"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "rules"
      ],
      "title": "RateLimitPolicyConfig",
      "type": "object"
    },
    "RateLimitRule": {
      "additionalProperties": false,
      "properties": {
        "backgroundMaxWaitMs": {
          "default": 0,
          "maximum": 3600000,
          "minimum": 0,
          "title": "Backgroundmaxwaitms",
          "type": "integer"
        },
        "burstRequests": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Burstrequests"
        },
        "cooldownSeconds": {
          "default": 0,
          "maximum": 86400,
          "minimum": 0,
          "title": "Cooldownseconds",
          "type": "integer"
        },
        "maxConcurrency": {
          "default": 1,
          "maximum": 10000,
          "minimum": 1,
          "title": "Maxconcurrency",
          "type": "integer"
        },
        "maxRequests": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Maxrequests",
          "type": "integer"
        },
        "operation": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "provider": {
          "enum": [
            "alpha_vantage",
            "quiver",
            "openai_responses"
          ],
          "title": "Provider",
          "type": "string"
        },
        "windowSeconds": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Windowseconds",
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "operation",
        "windowSeconds",
        "maxRequests"
      ],
      "title": "RateLimitRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config": {
      "$ref": "#/$defs/RateLimitPolicyConfig"
    },
    "description": {
      "default": "",
      "maxLength": 2048,
      "title": "Description",
      "type": "string"
    },
    "intendedUse": {
      "default": "research",
      "enum": [
        "research",
        "validation",
        "production_candidate"
      ],
      "title": "Intendeduse",
      "type": "string"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ],
      "title": "Status",
      "type": "string"
    },
    "thesis": {
      "default": "",
      "maxLength": 4096,
      "title": "Thesis",
      "type": "string"
    },
    "whatToMonitor": {
      "items": {
        "type": "string"
      },
      "title": "Whattomonitor",
      "type": "array"
    }
  },
  "required": [
    "name",
    "config"
  ],
  "title": "RateLimitPolicyUpsertRequest",
  "type": "object"
}
