{
  "$defs": {
    "RateLimitPolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "rules": {
          "items": {
            "$ref": "#/$defs/RateLimitRule"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "rules"
      ],
      "title": "RateLimitPolicyConfig",
      "type": "object"
    },
    "RateLimitPolicyRevision": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "$ref": "#/$defs/RateLimitPolicyConfig"
        },
        "configHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confighash"
        },
        "createdAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Createdat"
        },
        "createdBy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Createdby"
        },
        "description": {
          "default": "",
          "maxLength": 2048,
          "title": "Description",
          "type": "string"
        },
        "intendedUse": {
          "default": "research",
          "enum": [
            "research",
            "validation",
            "production_candidate"
          ],
          "title": "Intendeduse",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "active",
            "deprecated"
          ],
          "title": "Status",
          "type": "string"
        },
        "thesis": {
          "default": "",
          "maxLength": 4096,
          "title": "Thesis",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "whatToMonitor": {
          "items": {
            "type": "string"
          },
          "title": "Whattomonitor",
          "type": "array"
        }
      },
      "required": [
        "name",
        "version",
        "config"
      ],
      "title": "RateLimitPolicyRevision",
      "type": "object"
    },
    "RateLimitPolicySummary": {
      "additionalProperties": false,
      "properties": {
        "archived": {
          "default": false,
          "title": "Archived",
          "type": "boolean"
        },
        "description": {
          "default": "",
          "maxLength": 2048,
          "title": "Description",
          "type": "string"
        },
        "intendedUse": {
          "default": "research",
          "enum": [
            "research",
            "validation",
            "production_candidate"
          ],
          "title": "Intendeduse",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "providers": {
          "items": {
            "enum": [
              "alpha_vantage",
              "quiver",
              "openai_responses"
            ],
            "type": "string"
          },
          "title": "Providers",
          "type": "array"
        },
        "ruleCount": {
          "default": 0,
          "minimum": 0,
          "title": "Rulecount",
          "type": "integer"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "active",
            "deprecated"
          ],
          "title": "Status",
          "type": "string"
        },
        "thesis": {
          "default": "",
          "maxLength": 4096,
          "title": "Thesis",
          "type": "string"
        },
        "updatedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updatedat"
        },
        "usageCount": {
          "default": 0,
          "minimum": 0,
          "title": "Usagecount",
          "type": "integer"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "whatToMonitor": {
          "items": {
            "type": "string"
          },
          "title": "Whattomonitor",
          "type": "array"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "RateLimitPolicySummary",
      "type": "object"
    },
    "RateLimitRule": {
      "additionalProperties": false,
      "properties": {
        "backgroundMaxWaitMs": {
          "default": 0,
          "maximum": 3600000,
          "minimum": 0,
          "title": "Backgroundmaxwaitms",
          "type": "integer"
        },
        "burstRequests": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Burstrequests"
        },
        "cooldownSeconds": {
          "default": 0,
          "maximum": 86400,
          "minimum": 0,
          "title": "Cooldownseconds",
          "type": "integer"
        },
        "maxConcurrency": {
          "default": 1,
          "maximum": 10000,
          "minimum": 1,
          "title": "Maxconcurrency",
          "type": "integer"
        },
        "maxRequests": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Maxrequests",
          "type": "integer"
        },
        "operation": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "provider": {
          "enum": [
            "alpha_vantage",
            "quiver",
            "openai_responses"
          ],
          "title": "Provider",
          "type": "string"
        },
        "windowSeconds": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Windowseconds",
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "operation",
        "windowSeconds",
        "maxRequests"
      ],
      "title": "RateLimitRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activeRevision": {
      "anyOf": [
        {
          "$ref": "#/$defs/RateLimitPolicyRevision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy": {
      "$ref": "#/$defs/RateLimitPolicySummary"
    },
    "revisions": {
      "items": {
        "$ref": "#/$defs/RateLimitPolicyRevision"
      },
      "title": "Revisions",
      "type": "array"
    }
  },
  "required": [
    "policy"
  ],
  "title": "RateLimitPolicyDetailResponse",
  "type": "object"
}
