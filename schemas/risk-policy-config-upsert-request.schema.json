            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxleveragemultiple"
        },
        "maxLongExposurePct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 500.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxlongexposurepct"
        },
        "maxNetExposurePct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 500.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxnetexposurepct"
        },
        "maxSectorPct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxsectorpct"
        },
        "maxShortExposurePct": {
          "anyOf": [
            {
              "maximum": 500.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxshortexposurepct"
        },
        "maxSingleNamePct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxsinglenamepct"
        },
        "maxThemePct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxthemepct"
        },
        "weeklyLossLimitPct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weeklylosslimitpct"
        }
      },
      "title": "StrategyRiskExposureLimits",
      "type": "object"
    },
    "StrategyRiskLiquidityLimits": {
      "additionalProperties": false,
      "properties": {
        "maxAdvParticipationPct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxadvparticipationpct"
        },
        "maxBidAskSpreadBps": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxbidaskspreadbps"
        },
        "maxExitHorizonDays": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxexithorizondays"
        },
        "maxSlippageBps": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxslippagebps"
        },
        "minLiquidityScore": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minliquidityscore"
        }
      },
      "title": "StrategyRiskLiquidityLimits",
      "type": "object"
    },
    "StrategyRiskOverlayRule": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "warn",
            "reduce_exposure",
            "freeze_buys",
            "block_new_orders",
            "reduce_only",
            "liquidate"
          ],
          "title": "Action",
          "type": "string"
        },
        "cooldownBars": {
          "default": 0,
          "minimum": 0,
          "title": "Cooldownbars",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "exposureReductionPct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exposurereductionpct"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "requireApproval": {
          "default": false,
          "title": "Requireapproval",
          "type": "boolean"
        },
        "trigger": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "id",
        "trigger",
        "action"
      ],
      "title": "StrategyRiskOverlayRule",
      "type": "object"
    },
    "StrategyRiskOverlaySet": {
      "additionalProperties": false,
      "properties": {
        "correlationShock": {
          "items": {
            "$ref": "#/$defs/StrategyRiskOverlayRule"
          },
          "title": "Correlationshock",
          "type": "array"
        },
        "dataQuality": {
          "items": {
            "$ref": "#/$defs/StrategyRiskOverlayRule"
          },
          "title": "Dataquality",
          "type": "array"
        },
        "event": {
          "items": {
            "$ref": "#/$defs/StrategyRiskOverlayRule"
          },
          "title": "Event",
          "type": "array"
        },
        "liquidityStress": {
          "items": {
            "$ref": "#/$defs/StrategyRiskOverlayRule"
          },
          "title": "Liquiditystress",
          "type": "array"
        },
        "regime": {
          "items": {
            "$ref": "#/$defs/StrategyRiskOverlayRule"
          },
          "title": "Regime",
          "type": "array"
        }
      },
      "title": "StrategyRiskOverlaySet",
      "type": "object"
    },
    "StrategyRiskPolicy": {
      "additionalProperties": false,
      "properties": {
        "audit": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrategyRiskAuditPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dataQualityGates": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrategyRiskDataQualityGates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "exposureLimits": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrategyRiskExposureLimits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "liquidityLimits": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrategyRiskLiquidityLimits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operatingMode": {
          "anyOf": [
            {
              "enum": [
                "research_observe_only",
                "paper_controlled_pilot",
                "core_diversified_long",
                "balanced_long_short",
                "liquidity_constrained_smid",
                "catalyst_event_guarded",
                "stress_de_risk_mode"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operatingmode"
        },
        "overlays": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrategyRiskOverlaySet"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reentry": {
          "$ref": "#/$defs/StrategyRiskReentryPolicy"
        },
        "scope": {
          "default": "strategy",
          "enum": [
            "strategy",
            "sleeve"
          ],
          "title": "Scope",
          "type": "string"
        },
        "stopLoss": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrategyRiskStopLossPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "takeProfit": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrategyRiskTakeProfitPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tradingPermissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrategyRiskTradingPermissions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "StrategyRiskPolicy",
      "type": "object"
    },
    "StrategyRiskReentryPolicy": {
      "additionalProperties": false,
      "properties": {
        "cooldownBars": {
          "default": 0,
          "minimum": 0,
          "title": "Cooldownbars",
          "type": "integer"
        },
        "requireApproval": {
          "default": false,
          "title": "Requireapproval",
          "type": "boolean"
        }
      },
      "title": "StrategyRiskReentryPolicy",
      "type": "object"
    },
    "StrategyRiskStopLossPolicy": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "reduce_exposure",
          "enum": [
            "reduce_exposure",
            "liquidate",
            "freeze_buys"
          ],
          "title": "Action",
          "type": "string"
        },
        "basis": {
          "default": "strategy_nav_drawdown",
          "enum": [
            "strategy_nav_drawdown",
            "sleeve_nav_drawdown"
          ],
          "title": "Basis",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "id": {
          "default": "strategy-stop-loss",
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "reductionPct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reductionpct"
        },
        "thresholdPct": {
          "exclusiveMinimum": 0.0,
          "maximum": 100.0,
          "title": "Thresholdpct",
          "type": "number"
        }
      },
      "required": [
        "thresholdPct"
      ],
      "title": "StrategyRiskStopLossPolicy",
      "type": "object"
    },
    "StrategyRiskTakeProfitPolicy": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "rebalance_to_target",
          "enum": [
            "reduce_exposure",
            "rebalance_to_target"
          ],
          "title": "Action",
          "type": "string"
        },
        "basis": {
          "default": "strategy_nav_gain",
          "enum": [
            "strategy_nav_gain",
            "sleeve_nav_gain"
          ],
          "title": "Basis",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "id": {
          "default": "strategy-take-profit",
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "reductionPct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reductionpct"
        },
        "thresholdPct": {
          "exclusiveMinimum": 0.0,
          "maximum": 100.0,
          "title": "Thresholdpct",
          "type": "number"
        }
      },
      "required": [
        "thresholdPct"
      ],
      "title": "StrategyRiskTakeProfitPolicy",
      "type": "object"
    },
    "StrategyRiskTradingPermissions": {
      "additionalProperties": false,
      "properties": {
        "allowLiveOrders": {
          "default": false,
          "title": "Allowliveorders",
          "type": "boolean"
        },
        "allowedAssetClasses": {
          "items": {
            "enum": [
              "equity",
              "option"
            ],
            "type": "string"
          },
          "title": "Allowedassetclasses",
          "type": "array"
        },
        "allowedSides": {
          "items": {
            "enum": [
              "long",
              "short"
            ],
            "type": "string"
          },
          "title": "Allowedsides",
          "type": "array"
        },
        "optionsMode": {
          "default": "blocked",
          "enum": [
            "blocked",
            "covered_only",
            "defined_risk_only",
            "approval_required"
          ],
          "title": "Optionsmode",
          "type": "string"
        },
        "reduceOnly": {
          "default": false,
          "title": "Reduceonly",
          "type": "boolean"
        },
        "requireBorrowLocate": {
          "default": true,
          "title": "Requireborrowlocate",
          "type": "boolean"
        },
        "requireDifferentApprover": {
          "default": true,
          "title": "Requiredifferentapprover",
          "type": "boolean"
        },
        "requireOrderConfirmation": {
          "default": true,
          "title": "Requireorderconfirmation",
          "type": "boolean"
        }
      },
      "title": "StrategyRiskTradingPermissions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config": {
      "$ref": "#/$defs/RiskPolicyConfig"
    },
    "description": {
      "default": "",
      "maxLength": 2048,
      "title": "Description",
      "type": "string"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    }
  },
  "required": [
    "name",
    "config"
  ],
  "title": "RiskPolicyConfigUpsertRequest",
  "type": "object"
}
