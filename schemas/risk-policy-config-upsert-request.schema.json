{
  "$defs": {
    "RiskPolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "#/$defs/StrategyRiskPolicy"
        }
      },
      "required": [
        "policy"
      ],
      "title": "RiskPolicyConfig",
      "type": "object"
    },
    "StrategyRiskAuditPolicy": {
      "additionalProperties": false,
      "properties": {
        "auditRetentionDays": {
          "default": 2555,
          "minimum": 1,
          "title": "Auditretentiondays",
          "type": "integer"
        },
        "recordTriggeredOverlays": {
          "default": true,
          "title": "Recordtriggeredoverlays",
          "type": "boolean"
        },
        "requirePolicySnapshotHash": {
          "default": true,
          "title": "Requirepolicysnapshothash",
          "type": "boolean"
        }
      },
      "title": "StrategyRiskAuditPolicy",
      "type": "object"
    },
    "StrategyRiskDataQualityGates": {
      "additionalProperties": false,
      "properties": {
        "corporateActionPolicy": {
          "default": "freeze",
          "enum": [
            "allow",
            "warn",
            "freeze"
          ],
          "title": "Corporateactionpolicy",
          "type": "string"
        },
        "maxQuoteAgeSeconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxquoteageseconds"
        },
        "maxSecurityMasterAgeSeconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxsecuritymasterageseconds"
        },
        "minCoveragePct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mincoveragepct"
        },
        "minVendorQuorum": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minvendorquorum"
        },
        "requireSymbolIdentityLock": {
          "default": true,
          "title": "Requiresymbolidentitylock",
          "type": "boolean"
        },
        "requiredAdjustmentStatuses": {
          "items": {
            "enum": [
              "raw_allowed",
              "split_adjusted",
              "dividend_adjusted",
              "corporate_action_adjusted"
            ],
            "type": "string"
          },
          "title": "Requiredadjustmentstatuses",
          "type": "array"
        }
      },
      "title": "StrategyRiskDataQualityGates",
      "type": "object"
    },
    "StrategyRiskExposureLimits": {
      "additionalProperties": false,
      "properties": {
        "dailyLossLimitPct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dailylosslimitpct"
        },
        "drawdownBlockPct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drawdownblockpct"
        },
        "drawdownReducePct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drawdownreducepct"
