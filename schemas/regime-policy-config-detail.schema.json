          "items": {
            "enum": [
              "trending_up",
              "trending_down",
              "mean_reverting",
              "low_volatility",
              "high_volatility",
              "liquidity_stress",
              "macro_alignment",
              "unclassified"
            ],
            "type": "string"
          },
          "title": "Allowedregimes",
          "type": "array"
        },
        "blockWhenUnclassified": {
          "default": true,
          "title": "Blockwhenunclassified",
          "type": "boolean"
        },
        "blockedRegimes": {
          "items": {
            "enum": [
              "trending_up",
              "trending_down",
              "mean_reverting",
              "low_volatility",
              "high_volatility",
              "liquidity_stress",
              "macro_alignment",
              "unclassified"
            ],
            "type": "string"
          },
          "title": "Blockedregimes",
          "type": "array"
        },
        "honorModelHalt": {
          "default": true,
          "title": "Honormodelhalt",
          "type": "boolean"
        },
        "inactiveAction": {
          "const": "target_zero",
          "default": "target_zero",
          "title": "Inactiveaction",
          "type": "string"
        }
      },
      "title": "RegimeActivationPolicy",
      "type": "object"
    },
    "RegimePolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "activation": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegimeActivationPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "default": "observe_only",
          "enum": [
            "observe_only",
            "activation_gate"
          ],
          "title": "Mode",
          "type": "string"
        },
        "modelName": {
          "default": "default-regime",
          "maxLength": 128,
          "minLength": 1,
          "title": "Modelname",
          "type": "string"
        },
        "modelVersion": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modelversion"
        }
      },
      "title": "RegimePolicyConfig",
      "type": "object"
    },
    "RegimePolicyConfigRevision": {
      "additionalProperties": false,
      "properties": {
