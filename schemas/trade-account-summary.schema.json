{
  "$defs": {
    "BrokerPositionSizeLimit": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "pct_of_allocatable_capital",
          "enum": [
            "pct_of_allocatable_capital",
            "notional_base_ccy"
          ],
          "title": "Mode",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0.0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "BrokerPositionSizeLimit",
      "type": "object"
    },
    "BrokerTradeApprovalPolicy": {
      "additionalProperties": false,
      "properties": {
        "approvalMode": {
          "default": "disabled",
          "enum": [
            "disabled",
            "optional",
            "required"
          ],
          "title": "Approvalmode",
          "type": "string"
        },
        "enabledEnvironments": {
          "items": {
            "enum": [
              "paper",
              "sandbox",
              "live"
            ],
            "type": "string"
          },
          "title": "Enabledenvironments",
          "type": "array"
        },
        "maxLiveBearerNotional": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxlivebearernotional"
        },
        "recipientEmails": {
          "items": {
            "type": "string"
          },
          "title": "Recipientemails",
          "type": "array"
        },
        "recipientGroupId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipientgroupid"
        },
        "recipientPhoneNumbers": {
          "items": {
            "type": "string"
          },
          "title": "Recipientphonenumbers",
          "type": "array"
        },
        "releaseMode": {
          "default": "decision_only",
          "enum": [
            "decision_only",
            "paper_sandbox_bearer",
            "live_bearer"
          ],
          "title": "Releasemode",
          "type": "string"
        },
        "requireDistinctRequester": {
          "default": true,
          "title": "Requiredistinctrequester",
          "type": "boolean"
        },
        "tokenTtlSeconds": {
          "default": 900,
          "maximum": 86400,
          "minimum": 60,
          "title": "Tokenttlseconds",
          "type": "integer"
        }
      },
      "title": "BrokerTradeApprovalPolicy",
      "type": "object"
    },
    "BrokerTradingPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowLiveOrders": {
          "default": false,
          "title": "Allowliveorders",
          "type": "boolean"
        },
        "allowedAssetClasses": {
          "items": {
            "enum": [
              "equity",
              "option"
            ],
            "type": "string"
          },
          "title": "Allowedassetclasses",
          "type": "array"
        },
        "allowedSides": {
          "items": {
            "enum": [
              "long",
              "short"
            ],
            "type": "string"
          },
          "title": "Allowedsides",
          "type": "array"
        },
        "maxAdvParticipationPct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxadvparticipationpct"
        },
        "maxDailyLossPct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxdailylosspct"
        },
        "maxGrossExposurePct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 500.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxgrossexposurepct"
        },
        "maxNetExposurePct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 500.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxnetexposurepct"
        },
        "maxOpenPositions": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxopenpositions"
        },
        "maxSinglePositionExposure": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrokerPositionSizeLimit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reduceOnly": {
          "default": false,
          "title": "Reduceonly",
          "type": "boolean"
        },
        "requireBorrowLocate": {
          "default": true,
          "title": "Requireborrowlocate",
          "type": "boolean"
        },
        "requireOrderConfirmation": {
          "default": false,
          "title": "Requireorderconfirmation",
          "type": "boolean"
        },
        "tradeApproval": {
          "$ref": "#/$defs/BrokerTradeApprovalPolicy"
        }
      },
      "title": "BrokerTradingPolicy",
      "type": "object"
    },
    "TradeCapabilityFlags": {
      "additionalProperties": false,
      "properties": {
        "canCancel": {
          "default": false,
          "title": "Cancancel",
          "type": "boolean"
        },
        "canPreview": {
          "default": false,
          "title": "Canpreview",
          "type": "boolean"
        },
        "canReadAccount": {
          "default": false,
          "title": "Canreadaccount",
          "type": "boolean"
        },
        "canReadHistory": {
          "default": false,
          "title": "Canreadhistory",
          "type": "boolean"
        },
        "canReadOrders": {
          "default": false,
          "title": "Canreadorders",
          "type": "boolean"
        },
        "canReadPositions": {
          "default": false,
          "title": "Canreadpositions",
          "type": "boolean"
        },
        "canSubmitLive": {
          "default": false,
          "title": "Cansubmitlive",
          "type": "boolean"
        },
        "canSubmitPaper": {
          "default": false,
          "title": "Cansubmitpaper",
          "type": "boolean"
        },
        "canSubmitSandbox": {
          "default": false,
          "title": "Cansubmitsandbox",
          "type": "boolean"
        },
        "optionApprovalLevel": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optionapprovallevel"
        },
        "readOnly": {
          "default": true,
          "title": "Readonly",
          "type": "boolean"
        },
        "supportsEquities": {
          "default": false,
          "title": "Supportsequities",
          "type": "boolean"
        },
        "supportsEtfs": {
          "default": false,
          "title": "Supportsetfs",
          "type": "boolean"
        },
        "supportsFractionalQuantity": {
          "default": false,
          "title": "Supportsfractionalquantity",
          "type": "boolean"
        },
        "supportsLimitOrders": {
          "default": false,
          "title": "Supportslimitorders",
          "type": "boolean"
        },
        "supportsMarketOrders": {
          "default": false,
          "title": "Supportsmarketorders",
          "type": "boolean"
        },
        "supportsNotionalOrders": {
          "default": false,
          "title": "Supportsnotionalorders",
          "type": "boolean"
        },
        "supportsOptionChains": {
          "default": false,
          "title": "Supportsoptionchains",
          "type": "boolean"
        },
        "supportsOptionExercise": {
          "default": false,
          "title": "Supportsoptionexercise",
          "type": "boolean"
        },
        "supportsOptionGreeks": {
          "default": false,
          "title": "Supportsoptiongreeks",
          "type": "boolean"
        },
        "supportsOptionMultiLegOrders": {
          "default": false,
          "title": "Supportsoptionmultilegorders",
          "type": "boolean"
        },
        "supportsOptions": {
          "default": false,
          "title": "Supportsoptions",
          "type": "boolean"
        },
        "supportsStopOrders": {
          "default": false,
          "title": "Supportsstoporders",
          "type": "boolean"
        },
        "unsupportedReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupportedreason"
        }
      },
      "title": "TradeCapabilityFlags",
      "type": "object"
    },
    "TradeDataFreshness": {
      "additionalProperties": false,
      "properties": {
        "balancesAsOf": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Balancesasof"
        },
        "balancesState": {
          "default": "unknown",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ],
          "title": "Balancesstate",
          "type": "string"
        },
        "maxAgeSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxageseconds"
        },
        "ordersAsOf": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordersasof"
        },
        "ordersState": {
          "default": "unknown",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ],
          "title": "Ordersstate",
          "type": "string"
        },
        "positionsAsOf": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positionsasof"
        },
        "positionsState": {
          "default": "unknown",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ],
          "title": "Positionsstate",
          "type": "string"
        },
        "staleReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stalereason"
        }
      },
      "title": "TradeDataFreshness",
      "type": "object"
    },
    "TradeNormalizationWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "providerField": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Providerfield"
        },
        "rawValue": {
          "anyOf": [
            {
              "maxLength": 320,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rawvalue"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "info",
            "warning",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "TradeNormalizationWarning",
      "type": "object"
    },
    "TradePnlSnapshot": {
      "additionalProperties": false,
      "properties": {
        "asOf": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asof"
        },
        "dayPnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Daypnl"
        },
        "grossExposure": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grossexposure"
        },
        "netExposure": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Netexposure"
        },
        "realizedPnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realizedpnl"
        },
        "unrealizedPnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unrealizedpnl"
        }
      },
      "title": "TradePnlSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accountId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Accountid",
      "type": "string"
    },
    "accountNumberMasked": {
      "anyOf": [
        {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accountnumbermasked"
    },
    "baseCurrency": {
      "default": "USD",
      "maxLength": 3,
      "minLength": 3,
      "title": "Basecurrency",
      "type": "string"
    },
    "buyingPower": {
      "default": 0.0,
      "title": "Buyingpower",
      "type": "number"
    },
    "capabilities": {
      "$ref": "#/$defs/TradeCapabilityFlags"
    },
    "cash": {
      "default": 0.0,
      "title": "Cash",
      "type": "number"
    },
    "confirmationRequired": {
      "default": false,
      "title": "Confirmationrequired",
      "type": "boolean"
    },
    "environment": {
      "enum": [
        "paper",
        "sandbox",
        "live"
      ],
      "title": "Environment",
      "type": "string"
    },
    "equity": {
      "default": 0.0,
      "title": "Equity",
      "type": "number"
    },
    "freshness": {
      "$ref": "#/$defs/TradeDataFreshness"
    },
    "killSwitchActive": {
      "default": false,
      "title": "Killswitchactive",
      "type": "boolean"
    },
    "lastSyncedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lastsyncedat"
    },
    "lastTradeAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lasttradeat"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "normalizationWarnings": {
      "items": {
        "$ref": "#/$defs/TradeNormalizationWarning"
      },
      "title": "Normalizationwarnings",
      "type": "array"
    },
    "openOrderCount": {
      "default": 0,
      "minimum": 0,
      "title": "Openordercount",
      "type": "integer"
    },
    "pnl": {
      "anyOf": [
        {
          "$ref": "#/$defs/TradePnlSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policyVersion": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policyversion"
    },
    "positionCount": {
      "default": 0,
      "minimum": 0,
      "title": "Positioncount",
      "type": "integer"
    },
    "projectedTradingPolicy": {
      "anyOf": [
        {
          "$ref": "#/$defs/BrokerTradingPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider": {
      "enum": [
        "alpaca",
        "etrade",
        "schwab",
        "kalshi"
      ],
      "title": "Provider",
      "type": "string"
    },
    "quarantinedRowCount": {
      "default": 0,
      "minimum": 0,
      "title": "Quarantinedrowcount",
      "type": "integer"
    },
    "readiness": {
      "default": "review",
      "enum": [
        "ready",
        "review",
        "blocked"
      ],
      "title": "Readiness",
      "type": "string"
    },
    "readinessReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Readinessreason"
    },
    "snapshotAsOf": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshotasof"
    },
    "sourceObservedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sourceobservedat"
    },
    "syncRunId": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Syncrunid"
    },
    "unresolvedAlertCount": {
      "default": 0,
      "minimum": 0,
      "title": "Unresolvedalertcount",
      "type": "integer"
    }
  },
  "required": [
    "accountId",
    "name",
    "provider",
    "environment"
  ],
  "title": "TradeAccountSummary",
  "type": "object"
}
