          "type": "string"
        },
        "strategyId": {
          "anyOf": [
            {
              "enum": [
                "covered_call",
                "cash_secured_put",
                "long_call",
                "long_put",
                "protective_put",
                "collar",
                "bull_call_spread",
                "bear_put_spread",
                "bull_put_spread",
                "bear_call_spread",
                "long_straddle",
                "long_strangle",
                "iron_condor",
                "iron_butterfly",
