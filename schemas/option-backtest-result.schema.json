          "maxLength": 128,
          "minLength": 1,
          "title": "Eventid",
          "type": "string"
        },
        "eventType": {
          "enum": [
            "payoff_evaluated",
            "risk_gate",
            "data_quality_gate",
            "lifecycle_event",
            "research_only_block",
            "broker_preview_block"
          ],
