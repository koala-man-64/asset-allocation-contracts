{
  "$defs": {
    "ConfigIdentity": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "maxLength": 2048,
          "title": "Description",
          "type": "string"
        },
        "intendedUse": {
          "default": "research",
          "enum": [
            "research",
            "validation",
            "production_candidate"
          ],
          "title": "Intendeduse",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "active",
            "deprecated"
          ],
          "title": "Status",
          "type": "string"
        },
        "thesis": {
          "default": "",
          "maxLength": 4096,
          "title": "Thesis",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "whatToMonitor": {
          "items": {
            "type": "string"
          },
          "title": "Whattomonitor",
          "type": "array"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ConfigIdentity",
      "type": "object"
    },
    "RegimeActivationPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowedRegimes": {
          "items": {
            "enum": [
              "trending_up",
              "trending_down",
              "mean_reverting",
              "low_volatility",
              "high_volatility",
              "liquidity_stress",
              "macro_alignment",
              "unclassified"
            ],
            "type": "string"
          },
          "title": "Allowedregimes",
          "type": "array"
        },
        "blockWhenUnclassified": {
          "default": true,
          "title": "Blockwhenunclassified",
          "type": "boolean"
        },
        "blockedRegimes": {
          "items": {
            "enum": [
              "trending_up",
              "trending_down",
              "mean_reverting",
              "low_volatility",
              "high_volatility",
              "liquidity_stress",
              "macro_alignment",
              "unclassified"
            ],
            "type": "string"
          },
          "title": "Blockedregimes",
          "type": "array"
        },
        "honorModelHalt": {
          "default": true,
          "title": "Honormodelhalt",
          "type": "boolean"
        },
        "inactiveAction": {
          "const": "target_zero",
          "default": "target_zero",
          "title": "Inactiveaction",
          "type": "string"
        }
      },
      "title": "RegimeActivationPolicy",
      "type": "object"
    },
    "RegimePolicy": {
      "additionalProperties": false,
      "properties": {
        "activation": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegimeActivationPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "default": "observe_only",
          "enum": [
            "observe_only",
            "activation_gate"
          ],
          "title": "Mode",
          "type": "string"
        },
        "modelName": {
          "default": "default-regime",
          "maxLength": 128,
          "minLength": 1,
          "title": "Modelname",
          "type": "string"
        },
        "modelVersion": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modelversion"
        }
      },
      "title": "RegimePolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config": {
      "$ref": "#/$defs/RegimePolicy"
    },
    "identity": {
      "$ref": "#/$defs/ConfigIdentity"
    }
  },
  "required": [
    "identity",
    "config"
  ],
  "title": "RegimePolicyPreset",
  "type": "object"
}
