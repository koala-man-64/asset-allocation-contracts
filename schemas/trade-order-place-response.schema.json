{
  "$defs": {
    "OptionContractIdentity": {
      "additionalProperties": false,
      "properties": {
        "exerciseStyle": {
          "default": "american",
          "enum": [
            "american",
            "european"
          ],
          "title": "Exercisestyle",
          "type": "string"
        },
        "expirationDate": {
          "format": "date",
          "title": "Expirationdate",
          "type": "string"
        },
        "multiplier": {
          "default": 100,
          "exclusiveMinimum": 0,
          "title": "Multiplier",
          "type": "integer"
        },
        "optionSymbol": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Optionsymbol",
          "type": "string"
        },
        "right": {
          "enum": [
            "call",
            "put"
          ],
          "title": "Right",
          "type": "string"
        },
        "rootSymbol": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rootsymbol"
        },
        "settlementStyle": {
          "default": "physical",
          "enum": [
            "physical",
            "cash"
          ],
          "title": "Settlementstyle",
          "type": "string"
        },
        "strikePrice": {
          "exclusiveMinimum": 0,
          "title": "Strikeprice",
          "type": "number"
        },
        "underlyingSymbol": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Underlyingsymbol",
          "type": "string"
        }
      },
      "required": [
        "underlyingSymbol",
        "optionSymbol",
        "expirationDate",
        "strikePrice",
        "right"
      ],
      "title": "OptionContractIdentity",
      "type": "object"
    },
    "OptionLeg": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "$ref": "#/$defs/OptionContractIdentity"
        },
        "legId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Legid",
          "type": "string"
        },
        "limitPrice": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limitprice"
        },
        "openClose": {
          "default": "open",
          "enum": [
            "open",
            "close"
          ],
          "title": "Openclose",
          "type": "string"
        },
        "premium": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Premium"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "ratio": {
          "default": 1,
          "minimum": 1,
          "title": "Ratio",
          "type": "integer"
        },
        "role": {
          "enum": [
            "stock",
            "long_call",
            "short_call",
            "long_put",
            "short_put",
            "long_wing",
            "short_body",
            "underlying_stock",
            "cash_reserve"
          ],
          "title": "Role",
          "type": "string"
        },
        "side": {
          "enum": [
            "long",
            "short"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "legId",
        "contract",
        "side",
        "role"
      ],
      "title": "OptionLeg",
      "type": "object"
    },
    "TradeOrder": {
      "additionalProperties": false,
      "properties": {
        "acceptedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptedat"
        },
        "accountId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Accountid",
          "type": "string"
        },
        "assetClass": {
          "default": "equity",
          "enum": [
            "equity",
            "etf",
            "option",
            "crypto",
            "mutual_fund",
            "unknown"
          ],
          "title": "Assetclass",
          "type": "string"
        },
        "averageFillPrice": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Averagefillprice"
        },
        "cancelledAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancelledat"
        },
        "clientRequestId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clientrequestid"
        },
        "correlationId": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlationid"
        },
        "createdAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Createdat"
        },
        "environment": {
          "enum": [
            "paper",
            "sandbox",
            "live"
          ],
          "title": "Environment",
          "type": "string"
        },
        "estimatedNotional": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimatednotional"
        },
        "estimatedPrice": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimatedprice"
        },
        "expiresAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiresat"
        },
        "filledAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filledat"
        },
        "filledQuantity": {
          "default": 0.0,
          "minimum": 0,
          "title": "Filledquantity",
          "type": "number"
        },
        "idempotencyKey": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotencykey"
        },
        "limitPrice": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limitprice"
        },
        "notional": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notional"
        },
        "optionLegs": {
          "items": {
            "$ref": "#/$defs/OptionLeg"
          },
          "title": "Optionlegs",
          "type": "array"
        },
        "optionStrategyId": {
          "anyOf": [
            {
              "enum": [
                "covered_call",
                "cash_secured_put",
                "long_call",
                "long_put",
                "protective_put",
                "collar",
                "bull_call_spread",
                "bear_put_spread",
                "bull_put_spread",
                "bear_call_spread",
                "long_straddle",
                "long_strangle",
                "iron_condor",
                "iron_butterfly",
                "long_butterfly",
                "calendar_spread",
                "diagonal_spread",
                "pmcc",
                "covered_straddle",
                "covered_combination",
                "covered_strangle"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optionstrategyid"
        },
        "orderId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Orderid",
          "type": "string"
        },
        "orderType": {
          "enum": [
            "market",
            "limit",
            "stop",
            "stop_limit"
          ],
          "title": "Ordertype",
          "type": "string"
        },
        "provider": {
          "enum": [
            "alpaca",
            "etrade",
            "schwab",
            "kalshi"
          ],
          "title": "Provider",
          "type": "string"
        },
        "providerCorrelationId": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Providercorrelationid"
        },
        "providerOrderId": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Providerorderid"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "reconciliationRequired": {
          "default": false,
          "title": "Reconciliationrequired",
          "type": "boolean"
        },
        "riskChecks": {
          "items": {
            "$ref": "#/$defs/TradeRiskCheck"
          },
          "title": "Riskchecks",
          "type": "array"
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ],
          "title": "Side",
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "previewed",
            "submitted",
            "accepted",
            "partially_filled",
            "filled",
            "cancel_pending",
            "cancelled",
            "rejected",
            "expired",
            "unknown_reconcile_required"
          ],
          "title": "Status",
          "type": "string"
        },
        "statusReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statusreason"
        },
        "stopPrice": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stopprice"
        },
        "submittedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Submittedat"
        },
        "symbol": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "timeInForce": {
          "default": "day",
          "enum": [
            "day",
            "gtc",
            "opg",
            "cls",
            "ioc",
            "fok"
          ],
          "title": "Timeinforce",
          "type": "string"
        },
        "updatedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updatedat"
        }
      },
      "required": [
        "orderId",
        "accountId",
        "provider",
        "environment",
        "status",
        "symbol",
        "side",
        "orderType"
      ],
      "title": "TradeOrder",
      "type": "object"
    },
    "TradeRiskCheck": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "checkId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Checkid",
          "type": "string"
        },
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "severity": {
          "default": "info",
          "enum": [
            "info",
            "warning",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warning",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "checkId",
        "code",
        "label",
        "status"
      ],
      "title": "TradeRiskCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "auditEventId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Auditeventid"
    },
    "confirmationRequired": {
      "default": false,
      "title": "Confirmationrequired",
      "type": "boolean"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "order": {
      "$ref": "#/$defs/TradeOrder"
    },
    "policyVersion": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policyversion"
    },
    "reconciliationRequired": {
      "default": false,
      "title": "Reconciliationrequired",
      "type": "boolean"
    },
    "replayed": {
      "default": false,
      "title": "Replayed",
      "type": "boolean"
    },
    "submitted": {
      "default": false,
      "title": "Submitted",
      "type": "boolean"
    }
  },
  "required": [
    "order"
  ],
  "title": "TradeOrderPlaceResponse",
  "type": "object"
}
