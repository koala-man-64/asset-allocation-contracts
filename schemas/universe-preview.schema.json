        "type": "string"
      },
      "title": "Fieldsused",
      "type": "array"
    },
    "previewLimit": {
      "default": 25,
      "minimum": 1,
      "title": "Previewlimit",
      "type": "integer"
    },
    "rowCount": {
      "default": 0,
      "minimum": 0,
      "title": "Rowcount",
      "type": "integer"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/UniversePreviewRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "sampleSymbols": {
      "items": {
        "type": "string"
      },
      "title": "Samplesymbols",
      "type": "array"
    },
    "source": {
      "const": "postgres_gold",
      "default": "postgres_gold",
      "title": "Source",
      "type": "string"
    },
    "symbolCount": {
      "minimum": 0,
      "title": "Symbolcount",
      "type": "integer"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
