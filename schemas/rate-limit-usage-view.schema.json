            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policyname"
        },
        "policyVersion": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policyversion"
