          "type": "integer"
        },
        "workload": {
          "enum": [
            "interactive",
            "background"
          ],
          "title": "Workload",
          "type": "string"
        }
      },
      "required": [
        "observedAt",
        "provider",
        "operation",
        "workload",
        "reason",
        "retryAfterMs"
