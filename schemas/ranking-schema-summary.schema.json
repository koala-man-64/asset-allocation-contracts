{
  "$defs": {
    "RankingSchemaProfile": {
      "additionalProperties": false,
      "properties": {
        "directionCounts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "asc",
              "desc"
            ]
          },
          "title": "Directioncounts",
          "type": "object"
        },
        "factorColumns": {
          "items": {
            "type": "string"
          },
          "title": "Factorcolumns",
          "type": "array"
        },
        "factorCount": {
          "default": 0,
          "minimum": 0,
          "title": "Factorcount",
          "type": "integer"
        },
        "groupCount": {
          "default": 0,
          "minimum": 0,
          "title": "Groupcount",
          "type": "integer"
        },
        "groupNames": {
          "items": {
            "type": "string"
          },
          "title": "Groupnames",
          "type": "array"
        },
        "missingPolicyCounts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "exclude",
              "zero"
            ]
          },
          "title": "Missingpolicycounts",
          "type": "object"
        },
        "sourceTables": {
          "items": {
            "type": "string"
          },
          "title": "Sourcetables",
          "type": "array"
        },
        "transformTypes": {
          "items": {
            "enum": [
              "percentile_rank",
              "zscore",
              "minmax",
              "clip",
              "winsorize",
              "coalesce",
              "log1p",
              "negate",
              "abs"
            ],
            "type": "string"
          },
          "title": "Transformtypes",
          "type": "array"
        }
      },
      "title": "RankingSchemaProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "archived": {
      "default": false,
      "title": "Archived",
      "type": "boolean"
    },
    "description": {
      "default": "",
      "maxLength": 2048,
      "title": "Description",
      "type": "string"
    },
    "intendedUse": {
      "default": "research",
      "enum": [
        "research",
        "validation",
        "production_candidate"
      ],
      "title": "Intendeduse",
      "type": "string"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "schemaProfile": {
      "anyOf": [
        {
          "$ref": "#/$defs/RankingSchemaProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ],
      "title": "Status",
      "type": "string"
    },
    "thesis": {
      "default": "",
      "maxLength": 4096,
      "title": "Thesis",
      "type": "string"
    },
    "updatedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updatedat"
    },
    "usageCount": {
      "default": 0,
      "minimum": 0,
      "title": "Usagecount",
      "type": "integer"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "whatToMonitor": {
      "items": {
        "type": "string"
      },
      "title": "Whattomonitor",
      "type": "array"
    }
  },
  "required": [
    "name",
    "version"
  ],
  "title": "RankingSchemaSummary",
  "type": "object"
}
