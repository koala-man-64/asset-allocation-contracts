{
  "$defs": {
    "BrokerPositionSizeLimit": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "pct_of_allocatable_capital",
          "enum": [
            "pct_of_allocatable_capital",
            "notional_base_ccy"
          ],
          "title": "Mode",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0.0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "BrokerPositionSizeLimit",
      "type": "object"
    },
    "BrokerTradeApprovalPolicy": {
      "additionalProperties": false,
      "properties": {
        "approvalMode": {
          "default": "disabled",
          "enum": [
            "disabled",
            "optional",
            "required"
          ],
          "title": "Approvalmode",
          "type": "string"
        },
        "enabledEnvironments": {
          "items": {
            "enum": [
              "paper",
              "sandbox",
              "live"
            ],
            "type": "string"
          },
          "title": "Enabledenvironments",
          "type": "array"
        },
        "maxLiveBearerNotional": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxlivebearernotional"
        },
        "recipientEmails": {
          "items": {
            "type": "string"
          },
          "title": "Recipientemails",
          "type": "array"
        },
        "recipientGroupId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipientgroupid"
        },
        "recipientPhoneNumbers": {
          "items": {
            "type": "string"
          },
          "title": "Recipientphonenumbers",
          "type": "array"
        },
        "releaseMode": {
          "default": "decision_only",
          "enum": [
            "decision_only",
            "paper_sandbox_bearer",
            "live_bearer"
          ],
          "title": "Releasemode",
          "type": "string"
        },
        "requireDistinctRequester": {
          "default": true,
          "title": "Requiredistinctrequester",
          "type": "boolean"
        },
        "tokenTtlSeconds": {
          "default": 900,
          "maximum": 86400,
          "minimum": 60,
          "title": "Tokenttlseconds",
          "type": "integer"
        }
      },
      "title": "BrokerTradeApprovalPolicy",
      "type": "object"
    },
    "BrokerTradingPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowLiveOrders": {
          "default": false,
          "title": "Allowliveorders",
          "type": "boolean"
        },
        "allowedAssetClasses": {
          "items": {
            "enum": [
              "equity",
              "option"
            ],
            "type": "string"
          },
          "title": "Allowedassetclasses",
          "type": "array"
        },
        "allowedSides": {
          "items": {
            "enum": [
              "long",
              "short"
            ],
            "type": "string"
          },
          "title": "Allowedsides",
          "type": "array"
        },
        "maxAdvParticipationPct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxadvparticipationpct"
        },
        "maxDailyLossPct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxdailylosspct"
        },
        "maxGrossExposurePct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 500.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxgrossexposurepct"
        },
        "maxNetExposurePct": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 500.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxnetexposurepct"
        },
        "maxOpenPositions": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxopenpositions"
        },
        "maxSinglePositionExposure": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrokerPositionSizeLimit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reduceOnly": {
          "default": false,
          "title": "Reduceonly",
          "type": "boolean"
        },
        "requireBorrowLocate": {
          "default": true,
          "title": "Requireborrowlocate",
          "type": "boolean"
        },
        "requireOrderConfirmation": {
          "default": false,
          "title": "Requireorderconfirmation",
          "type": "boolean"
        },
        "tradeApproval": {
          "$ref": "#/$defs/BrokerTradeApprovalPolicy"
        }
      },
      "title": "BrokerTradingPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expectedConfigurationVersion": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expectedconfigurationversion"
    },
    "requestedPolicy": {
      "$ref": "#/$defs/BrokerTradingPolicy"
    }
  },
  "required": [
    "requestedPolicy"
  ],
  "title": "BrokerTradingPolicyUpdateRequest",
  "type": "object"
}
